---
<!-- ======================= HERO ======================= -->
<section class="hero">
  <svg class="hero__court" data-draw viewBox="0 0 1440 720" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
    <path d="M60 -40V760" stroke="#2a2e33" stroke-width="3"/>
    <path d="M-40 660H1480" stroke="#2a2e33" stroke-width="3"/>
    <path d="M60 300A360 360 0 0 1 420 660" stroke="#4D8CD4" stroke-width="3"/>
    <path d="M60 160A500 500 0 0 1 560 660" stroke="#1E5B96" stroke-width="2.5"/>
    <path d="M60 20A640 640 0 0 1 700 660" stroke="#1c2023" stroke-width="2.5"/>
    <path d="M1000 -40V760" stroke="#1c2023" stroke-width="2.5"/>
    <path d="M1180 -40V760" stroke="#1c2023" stroke-width="2.5"/>
    <circle cx="1000" cy="310" r="120" stroke="#1c2023" stroke-width="2.5"/>
  </svg>

  <div class="wrap hero__inner">
    <p class="eyebrow eyebrow--on-dark rv">{{ hero_eyebrow }}</p>
    <h1 class="rv rv-d1">{{ hero_heading | safe }}</h1>
    <p class="hero__sub rv rv-d2">{{ hero_sub }}</p>
    <div class="hero__cta rv rv-d3">
      <a class="btn btn--primary" href="/contact/">
        Get a Free Consultation
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="2"/></svg>
      </a>
      <a class="btn btn--ghost" href="/projects/">See Our Work</a>
    </div>
    <p class="hero__meta rv rv-d3">
      {% for tag in hero_meta_tags %}<span>{{ tag }}</span>{% endfor %}
    </p>
  </div>
</section>

<!-- ======================= TRUST BAR ======================= -->
<section class="trust" aria-label="Company at a glance">
  <div class="wrap">
    <ul>
      {% for s in trust_stats %}
      <li {% set _d = loop.index0 % 3 %}class="rv{% if _d > 0 %} rv-d{{ _d }}{% endif %}"><b><span data-count="{{ s.value }}">0</span><i>{{ s.suffix }}</i></b><span>{{ s.label }}</span></li>
      {% endfor %}
    </ul>
  </div>
</section>

<!-- ======================= SERVICES ======================= -->
<section class="sec" id="services" aria-labelledby="svc-h">
  <div class="wrap">
    <div class="sec__head">
      <div class="sec__label">
        <p class="eyebrow">{{ services_eyebrow }}</p>
        <h2 id="svc-h" class="rv">{{ services_heading }}</h2>
      </div>
      <p class="rv rv-d1">{{ services_intro }}</p>
    </div>

    <div class="cards">
      {% for svc in services %}
      <a {% set _d = loop.index0 % 3 %}class="card rv{% if _d > 0 %} rv-d{{ _d }}{% endif %}" href="/services/">
        <span class="card__n">{{ svc.number }}</span>
        <svg class="card__ico" viewBox="0 0 100 100" aria-hidden="true"><path d="{{ svc.icon_path }}"/></svg>
        <h3>{{ svc.title }}</h3>
        <p>{{ svc.description }}</p>
        <span class="card__more">Explore <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="2"/></svg></span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ======================= STANDARDS ======================= -->
<section class="std angle-top angle-btm" aria-label="Standards we build to">
  <div class="wrap std__row">
    <p class="std__lead">{{ standards_lead | safe }}</p>
    <div class="std__badges">
      {% for b in standards_badges %}
      <div {% set _d = loop.index0 % 3 %}class="badge rv{% if _d > 0 %} rv-d{{ _d }}{% endif %}"><b>{{ b.code }}</b><span>{{ b.label }}</span></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ======================= STATEMENT ======================= -->
<section class="sec stmt" aria-labelledby="stmt-h">
  <svg class="stmt__wm" viewBox="0 0 100 100" fill="none" aria-hidden="true">
    <path d="M13 4V93.5" stroke="#0B0F0D" stroke-width="13"/>
    <path d="M6.5 87H97" stroke="#0B0F0D" stroke-width="13"/>
    <path d="M13 51A36 36 0 0 1 49 87" stroke="#0B0F0D" stroke-width="13"/>
    <circle cx="74" cy="47" r="8" fill="#0B0F0D"/>
  </svg>
  <div class="wrap">
    <p class="eyebrow rv">{{ statement_eyebrow }}</p>
    <blockquote class="rv rv-d1">
      <p id="stmt-h">{{ statement_quote | safe }}</p>
    </blockquote>
    <div class="stmt__body rv rv-d2">
      {% for para in statement_paragraphs %}<p>{{ para }}</p>{% endfor %}
    </div>
  </div>
</section>

<!-- ======================= PROJECTS ======================= -->
<section class="sec" id="projects" aria-labelledby="proj-h">
  <div class="wrap">
    <div class="sec__head">
      <div class="sec__label">
        <p class="eyebrow">{{ projects_eyebrow }}</p>
        <h2 id="proj-h" class="rv">{{ projects_heading }}</h2>
      </div>
      <p class="rv rv-d1">{{ projects_intro }}</p>
    </div>

    <div class="filters" data-filters role="group" aria-label="Filter projects by sport">
      <button type="button" data-filter="all" aria-pressed="true">All</button>
      <button type="button" data-filter="football" aria-pressed="false">Football</button>
      <button type="button" data-filter="pickleball" aria-pressed="false">Pickleball</button>
      <button type="button" data-filter="badminton" aria-pressed="false">Badminton</button>
      <button type="button" data-filter="basketball" aria-pressed="false">Basketball</button>
      <button type="button" data-filter="tennis" aria-pressed="false">Tennis</button>
      <button type="button" data-filter="track" aria-pressed="false">Track</button>
    </div>

    <div class="grid-proj">
      {% for p in featured_projects %}
      <a {% set _d = loop.index0 % 3 %}class="proj rv{% if _d > 0 %} rv-d{{ _d }}{% endif %}" href="/projects/" data-sport="{{ p.sport }}">
        <div class="proj__img"><img class="proj__ph" src="{{ p.image }}" alt="{{ p.alt }}" loading="lazy"></div>
        <div class="proj__body"><h3>{{ p.title }}</h3><p class="mono">{{ p.meta }}</p></div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ======================= CLIENTS ======================= -->
<section class="sec sec--chalk" aria-labelledby="cl-h">
  <div class="wrap">
    <div class="sec__head">
      <div class="sec__label">
        <p class="eyebrow">{{ clients_eyebrow }}</p>
        <h2 id="cl-h" class="rv">{{ clients_heading }}</h2>
      </div>
    </div>
    <ul class="clients rv rv-d1">
      {% for logo in client_logos %}<li>{{ logo }}</li>{% endfor %}
    </ul>
  </div>
</section>

<!-- ======================= REVIEWS ======================= -->
<section class="sec" aria-labelledby="rev-h">
  <div class="wrap">
    <div class="sec__head">
      <div class="sec__label">
        <p class="eyebrow">{{ reviews_eyebrow }}</p>
        <h2 id="rev-h" class="rv">{{ reviews_heading }}</h2>
      </div>
      <p class="rv rv-d1">{{ reviews_note }}</p>
    </div>
    <div class="reviews">
      {% for r in reviews %}
      <blockquote {% set _d = loop.index0 % 3 %}class="review rv{% if _d > 0 %} rv-d{{ _d }}{% endif %}">
        <div class="review__stars" aria-label="5 out of 5">
          {% for i in range(5) %}<svg viewBox="0 0 16 16"><path d="M8 1l2.1 4.6 5 .5-3.7 3.4 1 4.9L8 11.9 3.6 14.4l1-4.9L.9 6.1l5-.5z"/></svg>{% endfor %}
        </div>
        <p>{{ r.text }}</p>
        <footer><b>{{ r.name }}</b><span>{{ r.role }}</span></footer>
      </blockquote>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ======================= PROCESS ======================= -->
<section class="sec sec--dark angle-top" aria-labelledby="pr-h">
  <div class="wrap">
    <div class="sec__head">
      <div class="sec__label">
        <p class="eyebrow eyebrow--on-dark">{{ process_eyebrow }}</p>
        <h2 id="pr-h" class="rv">{{ process_heading }}</h2>
      </div>
      <p class="rv rv-d1">{{ process_intro }}</p>
    </div>
    <div class="steps">
      {% for step in process_steps %}
      <div class="step"><span class="step__n">{{ step.number }}</span><h3>{{ step.title }}</h3><p>{{ step.description }}</p><span class="step__bar"><i></i></span></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ======================= CTA ======================= -->
<section class="cta">
  <div class="wrap cta__row">
    <div>
      <h2 class="rv">{{ cta_heading }}</h2>
      <p class="rv rv-d1">{{ cta_text }}</p>
    </div>
    <div class="cta__btns rv rv-d2">
      <a class="btn btn--dark" href="/contact/">
        Get a Free Consultation
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="2"/></svg>
      </a>
      <a class="btn btn--dark" href="https://wa.me/{{ site.whatsapp_number }}?text={{ site.whatsapp_default_message | urlencode }}" target="_blank" rel="noopener">WhatsApp Us</a>
    </div>
  </div>
</section>
