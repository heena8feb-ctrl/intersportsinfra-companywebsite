<section class="phero">
  <svg class="phero__court" data-draw viewBox="0 0 1440 460" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
    <path d="M70 -40V500" stroke="#2a2e33" stroke-width="3"/>
    <path d="M-40 420H1480" stroke="#2a2e33" stroke-width="3"/>
    <path d="M70 200A220 220 0 0 1 290 420" stroke="#4D8CD4" stroke-width="3"/>
    <path d="M70 60A360 360 0 0 1 430 420" stroke="#1E5B96" stroke-width="2.5"/>
    <path d="M1080 -40V500" stroke="#1c2023" stroke-width="2.5"/>
    <circle cx="1080" cy="190" r="110" stroke="#1c2023" stroke-width="2.5"/>
  </svg>
  <div class="wrap phero__in">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Projects</span></nav>
    <p class="eyebrow eyebrow--on-dark rv">{{ hero_eyebrow }}</p>
    <h1 class="rv rv-d1">{{ hero_heading | safe }}</h1>
    <p class="rv rv-d2">{{ hero_sub }}</p>
    <div class="phero__cta rv rv-d3"><a class="btn btn--primary" href="/contact/">Start Your Project <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="2"/></svg></a></div>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <div data-filters-multi>
      <div class="filters" role="group" aria-label="Filter by sport">
        <button type="button" data-key="sport" data-val="all" aria-pressed="true">All sports</button>
        <button type="button" data-key="sport" data-val="padel" aria-pressed="false">Padel</button>
        <button type="button" data-key="sport" data-val="cricket" aria-pressed="false">Cricket</button>
        <button type="button" data-key="sport" data-val="football" aria-pressed="false">Football</button>
        <button type="button" data-key="sport" data-val="pickleball" aria-pressed="false">Pickleball</button>
        <button type="button" data-key="sport" data-val="badminton" aria-pressed="false">Badminton</button>
        <button type="button" data-key="sport" data-val="basketball" aria-pressed="false">Basketball</button>
        <button type="button" data-key="sport" data-val="tennis" aria-pressed="false">Tennis</button>
        <button type="button" data-key="sport" data-val="track" aria-pressed="false">Track</button>
      </div>
      <div class="filters" role="group" aria-label="Filter by project type" style="margin-bottom:34px">
        <button type="button" data-key="type" data-val="all" aria-pressed="true">All types</button>
        <button type="button" data-key="type" data-val="new" aria-pressed="false">New build</button>
        <button type="button" data-key="type" data-val="reno" aria-pressed="false">Renovation</button>
      </div>
    </div>
    <div class="grid-proj">
      {% for p in projects %}
      {% set _d = loop.index0 % 3 %}
      <a class="proj rv{% if _d > 0 %} rv-d{{ _d }}{% endif %}" href="/contact/" data-sport="{{ p.sport }}" data-type="{{ p.type }}">
        <div class="proj__img"><img class="proj__ph" src="{{ p.image }}" alt="{{ p.alt }}" loading="lazy"></div>
        <div class="proj__body"><h3>{{ p.title }}</h3><p class="mono">{{ p.meta }}</p></div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="cta">
  <div class="wrap cta__row">
    <div><h2 class="rv">{{ cta_heading }}</h2><p class="rv rv-d1">{{ cta_text }}</p></div>
    <div class="cta__btns rv rv-d2">
      <a class="btn btn--dark" href="/contact/">Get a Free Consultation <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="2"/></svg></a>
      <a class="btn btn--dark" href="https://wa.me/{{ site.whatsapp_number }}?text={{ site.whatsapp_default_message | urlencode }}" target="_blank" rel="noopener">WhatsApp Us</a>
    </div>
  </div>
</section>
