      {% set _d = loop.index0 % 3 %}
      <a class="proj rv{% if _d > 0 %} rv-d{{ _d }}{% endif %}" href="#case-1" data-sport="{{ p.sport }}" data-type="{{ p.type }}">
        <div class="proj__img"><img class="proj__ph" src="{{ p.image }}" alt="{{ p.alt }}" loading="lazy"></div>
        <div class="proj__body"><h3>{{ p.title }}</h3><p class="mono">{{ p.meta }}</p></div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="sec sec--chalk">
  <div class="wrap">
    <div class="sec__head">
      <div class="sec__label"><p class="eyebrow">{{ ba_eyebrow }}</p><h2 class="rv">{{ ba_heading }}</h2></div>
      <p class="rv rv-d1">{{ ba_intro }}</p>
    </div>
    <div class="ba rv rv-d1">
      <div class="ba__layer ba__layer--before"><img class="ph" src="{{ ba_before_image }}" alt="{{ ba_before_alt }}" loading="lazy"></div>
      <div class="ba__layer ba__layer--after"><img class="ph" src="{{ ba_after_image }}" alt="{{ ba_after_alt }}" loading="lazy"></div>
      <span class="ba__tag ba__tag--b">Before</span>
      <span class="ba__tag ba__tag--a">After</span>
      <span class="ba__handle" aria-hidden="true"></span>
      <input class="ba__range" type="range" min="0" max="100" value="50" aria-label="Reveal the after photograph">
    </div>
  </div>
</section>

{% for cs in case_studies %}
<section class="sec{% if cs.dark %} sec--dark{% endif %}"{% if loop.index0 == 0 %} id="case-1"{% endif %}>
  <div class="wrap">
    <div class="sec__head">
      <div class="sec__label"><p class="eyebrow{% if cs.dark %} eyebrow--on-dark{% endif %}">{{ cs.eyebrow }}</p><h2 class="rv">{{ cs.heading }}</h2></div>
      <p class="rv rv-d1">{{ cs.meta }}</p>
    </div>
    <div class="case rv rv-d1"{% if cs.dark %} style="background:#2a2e33"{% endif %}>
      {% for col in cs.columns %}
      <div{% if cs.dark %} style="background:#0B0F0D"{% endif %}>
        <h4>{{ col.heading }}</h4>
        <p{% if cs.dark %} style="color:#8b939b"{% endif %}>{{ col.text }}</p>
        <ul>{% for item in col.items %}<li{% if cs.dark %} style="color:#8b939b"{% endif %}>{{ item }}</li>{% endfor %}</ul>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endfor %}

