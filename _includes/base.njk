<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="theme-color" content="#0B0F0D">
<link rel="canonical" href="{{ site.website }}{{ page.url | replace('/index.html','') | replace('.html','') }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/favicon.svg">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ ogDescription or description }}">
<meta property="og:url" content="{{ site.website }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
<script>document.documentElement.className="js-reveal";</script>
{% if schema %}
<script type="application/ld+json">
{{ schema | jsonify | safe }}
</script>
{% endif %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<!-- ======================= HEADER ======================= -->
<header class="hdr">
  <div class="wrap hdr__bar">
    <a class="brand" href="/" aria-label="{{ site.company_name }} — home">
      <svg viewBox="0 0 100 100" fill="none" aria-hidden="true">
        <path d="M13 4V93.5" stroke="#0B0F0D" stroke-width="13"/>
        <path d="M6.5 87H97" stroke="#0B0F0D" stroke-width="13"/>
        <path d="M13 51A36 36 0 0 1 49 87" stroke="#4D8CD4" stroke-width="13"/>
        <circle cx="74" cy="47" r="8" fill="#4D8CD4"/>
      </svg>
      <span class="brand__wm">
        <span class="brand__name">INTER SPORTS</span>
        <span class="brand__sub"><i></i><span>INFRA</span></span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <a href="/" {% if nav=='home' %}aria-current="page"{% endif %}>Home</a>
      <a href="/services/" {% if nav=='services' %}aria-current="page"{% endif %}>Services</a>
      <a href="/projects/" {% if nav=='projects' %}aria-current="page"{% endif %}>Projects</a>
      <a href="/about/" {% if nav=='about' %}aria-current="page"{% endif %}>About</a>
      <a href="/maintenance/" {% if nav=='maintenance' %}aria-current="page"{% endif %}>Maintenance</a>
      <a href="/faq/" {% if nav=='faq' %}aria-current="page"{% endif %}>FAQ</a>
      <a href="/contact/" {% if nav=='contact' %}aria-current="page"{% endif %}>Contact</a>
    </nav>

    <div class="hdr__contact">
      <a href="tel:{{ site.phone_link }}">{{ site.phone_display }}</a>
      <a class="wa" href="https://wa.me/{{ site.whatsapp_number }}?text={{ site.whatsapp_default_message | urlencode }}" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2Zm5.8 14.16c-.25.7-1.44 1.34-1.98 1.39-.54.05-1.04.24-2.94-.61-2.28-1.02-3.72-3.4-3.83-3.56-.11-.16-.9-1.24-.9-2.36 0-1.12.58-1.67.79-1.9.2-.23.44-.29.59-.29h.42c.14 0 .32-.05.5.38.18.43.63 1.53.68 1.64.05.11.09.24.01.39-.07.16-.14.25-.28.4l-.2.24c-.09.11-.19.22-.08.42.11.2.5.86 1.06 1.4.73.68 1.34.9 1.53.99.19.1.3.08.42-.05.11-.13.5-.58.63-.78.13-.2.26-.16.44-.1.18.07 1.13.53 1.32.63.19.09.32.14.37.22.05.09.05.52-.2 1.22Z"/></svg>
      </a>
    </div>

    <button class="burger" aria-expanded="false" aria-controls="drawer" aria-label="Menu">
      <i></i><i></i><i></i>
    </button>
  </div>
</header>

<div class="drawer" id="drawer" data-open="false">
  <a href="/">Home</a>
  <a href="/services/">Services</a>
  <a href="/projects/">Projects</a>
  <a href="/about/">About</a>
  <a href="/maintenance/">Maintenance</a>
  <a href="/faq/">FAQ</a>
  <a href="/contact/">Contact</a>
  <div class="drawer__foot">
    <a href="tel:{{ site.phone_link }}">{{ site.phone_display }}</a>
    <a href="mailto:{{ site.email }}">{{ site.email }}</a>
  </div>
</div>

<main id="main">
{{ content | safe }}
</main>

<!-- ======================= FOOTER ======================= -->
<footer class="ftr">
  <div class="wrap">
    <div class="ftr__grid">
      <div class="ftr__brand">
        <a class="brand" href="/" aria-label="{{ site.company_name }} — home">
          <svg viewBox="0 0 100 100" fill="none" aria-hidden="true">
            <path d="M13 4V93.5" stroke="#FFFFFF" stroke-width="13"/>
            <path d="M6.5 87H97" stroke="#FFFFFF" stroke-width="13"/>
            <path d="M13 51A36 36 0 0 1 49 87" stroke="#4D8CD4" stroke-width="13"/>
            <circle cx="74" cy="47" r="8" fill="#4D8CD4"/>
          </svg>
          <span class="brand__wm">
            <span class="brand__name">INTER SPORTS</span>
            <span class="brand__sub"><i></i><span>INFRA</span></span>
          </span>
        </a>
        <p class="ftr__tag">{{ site.tagline }}</p>
        <p class="ftr__addr">{{ site.company_name }}<br>{{ site.address_line1 }}<br>{{ site.address_line2 }}</p>
        <div class="ftr__certs">
          {% for cert in site.certifications %}<span>{{ cert }}</span>{% endfor %}
        </div>
      </div>

      <div>
        <h4>Quick links</h4>
        <ul>
          <li><a href="/services/">Services</a></li>
          <li><a href="/projects/">Projects</a></li>
          <li><a href="/about/">About us</a></li>
          <li><a href="/maintenance/">Maintenance</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>

      <div>
        <h4>Service area</h4>
        <ul>
          {% for area in site.service_areas %}<li>{{ area }}</li>{% endfor %}
        </ul>
      </div>

      <div>
        <h4>Talk to us</h4>
        <ul class="ftr__contact">
          <li><a href="tel:{{ site.phone_link }}">{{ site.phone_display }}</a></li>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><a href="{{ site.website }}">www.intersportsinfra.com</a></li>
        </ul>
        <div class="ftr__social">
          <a href="https://wa.me/{{ site.whatsapp_number }}" target="_blank" rel="noopener" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2Zm5.8 14.16c-.25.7-1.44 1.34-1.98 1.39-.54.05-1.04.24-2.94-.61-2.28-1.02-3.72-3.4-3.83-3.56-.11-.16-.9-1.24-.9-2.36 0-1.12.58-1.67.79-1.9.2-.23.44-.29.59-.29h.42c.14 0 .32-.05.5.38.18.43.63 1.53.68 1.64.05.11.09.24.01.39-.07.16-.14.25-.28.4l-.2.24c-.09.11-.19.22-.08.42.11.2.5.86 1.06 1.4.73.68 1.34.9 1.53.99.19.1.3.08.42-.05.11-.13.5-.58.63-.78.13-.2.26-.16.44-.1.18.07 1.13.53 1.32.63.19.09.32.14.37.22.05.09.05.52-.2 1.22Z"/></svg>
          </a>
          <a href="{{ site.social.instagram_url }}" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.6.23 1 .5 1.5 1 .5.5.77.9 1 1.5.17.4.37 1 .42 2.2.07 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.05 1.2-.25 1.8-.42 2.2-.23.6-.5 1-1 1.5-.5.5-.9.77-1.5 1-.4.17-1 .37-2.2.42-1.3.07-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.2-.05-1.8-.25-2.2-.42-.6-.23-1-.5-1.5-1-.5-.5-.77-.9-1-1.5-.17-.4-.37-1-.42-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.05-1.2.25-1.8.42-2.2.23-.6.5-1 1-1.5.5-.5.9-.77 1.5-1 .4-.17 1-.37 2.2-.42C8.4 2.2 8.8 2.2 12 2.2Zm0 3.2a6.6 6.6 0 1 0 0 13.2 6.6 6.6 0 0 0 0-13.2Zm0 2.3a4.3 4.3 0 1 1 0 8.6 4.3 4.3 0 0 1 0-8.6Zm6.9-2.6a1.55 1.55 0 1 1-3.1 0 1.55 1.55 0 0 1 3.1 0Z"/></svg>
          </a>
          <a href="{{ site.social.linkedin_url }}" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C21 8.65 22 10.4 22 13.4V21h-4v-6.8c0-1.6-.6-2.7-2-2.7-1.2 0-1.9.8-2.2 1.6-.1.3-.13.7-.13 1.1V21h-4V9Z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <p class="ftr__cities" style="margin-top:44px">{{ site.footer_cities_line }}</p>

    <div class="ftr__base">
      <p>Turf · Courts · Tracks · Flooring · Civil</p>
      <p>© <span data-year>2026</span> {{ site.company_name }} · GSTIN {{ site.gstin }}</p>
    </div>
  </div>
</footer>

<!-- ======================= MOBILE CALL BAR ======================= -->
<nav class="mbar" aria-label="Quick contact">
  <a href="tel:{{ site.phone_link }}">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8c1.2 2.3 3.1 4.2 5.4 5.4l1.8-1.8c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V19c0 .6-.4 1-1 1-8.3 0-15-6.7-15-15 0-.6.4-1 1-1h3.2c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1l-1.8 1.8Z"/></svg>
    Call now
  </a>
  <a href="https://wa.me/{{ site.whatsapp_number }}?text={{ site.whatsapp_default_message | urlencode }}" target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2Zm5.8 14.16c-.25.7-1.44 1.34-1.98 1.39-.54.05-1.04.24-2.94-.61-2.28-1.02-3.72-3.4-3.83-3.56-.11-.16-.9-1.24-.9-2.36 0-1.12.58-1.67.79-1.9.2-.23.44-.29.59-.29h.42c.14 0 .32-.05.5.38.18.43.63 1.53.68 1.64.05.11.09.24.01.39-.07.16-.14.25-.28.4l-.2.24c-.09.11-.19.22-.08.42.11.2.5.86 1.06 1.4.73.68 1.34.9 1.53.99.19.1.3.08.42-.05.11-.13.5-.58.63-.78.13-.2.26-.16.44-.1.18.07 1.13.53 1.32.63.19.09.32.14.37.22.05.09.05.52-.2 1.22Z"/></svg>
    WhatsApp
  </a>
</nav>

<script src="/script.js" defer></script>

<!--
  Netlify Identity is loaded on every page (not just /admin) because
  invite, password-recovery and email-confirmation links from Netlify
  always redirect to the site's root URL, not to /admin directly. If the
  widget isn't present on whichever page the link lands on, it can't see
  the token in the URL and the "set your password" step silently fails.
  This runs invisibly for normal visitors — it only does anything when a
  token is present in the URL.
-->
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js" defer></script>
<script>
  window.addEventListener("DOMContentLoaded", function () {
    if (window.netlifyIdentity) {
      window.netlifyIdentity.init({
        APIUrl: "https://intersportsinfra-cms.netlify.app/.netlify/identity"
      });
    }
  });
</script>
</body>
</html>
